# Server Configuration
PORT=4000
# Database: MongoDB Connection URI (must start with mongodb:// or mongodb+srv://)
# Local development replica set example: "mongodb://127.0.0.1:27018/skillswap?replicaSet=rs0&directConnection=true"
# MongoDB Atlas production example: "mongodb+srv://<user>:<password>@<cluster>.mongodb.net/skillswap?retryWrites=true&w=majority"
MONGODB_URL="mongodb://127.0.0.1:27018/skillswap?replicaSet=rs0&directConnection=true"

# JWT Secret for Cookie Sessions (MUST be at least 32 characters in production)
# Generate a secure secret using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="skillswap-super-secret-jwt-key-min-32-chars-long-development"

# Environment
NODE_ENV="development"

# CORS / CSRF Allowed Origins (comma-separated)
# In production (NODE_ENV=production), MUST contain your real public site origin
# (for example: "https://skillswap.example.com" or "http://localhost:4000" for local prod testing)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:4000"

# Reverse Proxy Trust Configuration:
# Set to "true" (or specific IP/CIDR/hop count) ONLY when deployed behind a trusted reverse proxy
# such as NGINX, Cloudflare, AWS ALB, Render, or Railway.
# WARNING: If left "true" when the server is directly internet-facing, clients can forge
# the X-Forwarded-For header to spoof IP addresses and bypass rate limiting.
# When "false", Express ignores X-Forwarded-For and uses req.socket.remoteAddress safely.
TRUST_PROXY="false"

# Rate Limiting Disabled (honored ONLY when NODE_ENV is not 'production')
RATE_LIMIT_DISABLED="false"

# External API Integrations
NOMINATIM_USER_AGENT="SkillSwap-App/1.0"

# Avatar Storage Strategy: "mongo" (stores images as Bytes in MongoDB AvatarFile collection)
# or "disk" (stores files in AVATAR_STORAGE_DIR). Default: "mongo".
AVATAR_STORAGE="mongo"
AVATAR_STORAGE_DIR="../public/uploads/avatars"

# Public Application URL (required for OAuth callbacks and email links)
# Development: "http://localhost:5173" (browser origin via Vite proxy)
# Production: exact https site URL, e.g. "https://skillswap.onrender.com"
PUBLIC_URL="http://localhost:5173"

# Google Cloud OAuth 2.0 (dormant until configured)
# Create credentials in Google Cloud Console > APIs & Services > Credentials
# Redirect URI: ${PUBLIC_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend Email Notifications (dormant until configured)
# API key from https://resend.com
RESEND_API_KEY=""
# Sender address on a domain verified in Resend (e.g. notifications@yourdomain.com)
EMAIL_FROM=""
# Optional dry run mode: logs subject and recipient domain only, sends no network requests
EMAIL_DRY_RUN="false"
