# ==========================================
# SKILLSWAP ROOT ENVIRONMENT REFERENCE
# Server runtime variables belong in: server/.env (see server/.env.example)
# ==========================================

# Prisma CLI MongoDB connection string when running prisma commands from repository root
# Example: "mongodb://127.0.0.1:27018/skillswap?replicaSet=rs0&directConnection=true"
MONGODB_URL="mongodb://127.0.0.1:27018/skillswap?replicaSet=rs0&directConnection=true"

# Public Site URL
PUBLIC_URL="http://localhost:5173"

# Google OAuth 2.0 (dormant until configured)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend Email (dormant until configured)
RESEND_API_KEY=""
EMAIL_FROM=""
