# ==========================================
# SKILLSWAP ENVIRONMENT VARIABLES CONFIGURATION
# Copy this file to .env and fill in your values
# ==========================================

# ------------------------------------------
# 1. DATABASE CONFIGURATION (SQLite / PostgreSQL)
# ------------------------------------------
# Default: Zero-config local SQLite database file (Requires NO database server installation!)
DATABASE_URL="file:./dev.db"

# Alternative: PostgreSQL connection string (Supabase or local Postgres server)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skillswap?schema=public"


# ------------------------------------------
# 2. NEXTAUTH AUTHENTICATION CONFIGURATION
# ------------------------------------------
# A secret key used by NextAuth to encrypt tokens.
NEXTAUTH_SECRET="skillswap_super_secret_key_change_me_in_production"

# Base URL of the application
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth Credentials (Optional)
GOOGLE_CLIENT_ID="your-google-client-id-here.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret-here"


# ------------------------------------------
# 3. MAPS CONFIGURATION
# ------------------------------------------
NEXT_PUBLIC_MAP_PROVIDER="leaflet"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key-here"


# ------------------------------------------
# 4. APP CONFIGURATION
# ------------------------------------------
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"
