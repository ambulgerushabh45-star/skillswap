// Prisma Schema for SkillSwap Platform
// Configured with SQLite for zero-config local development (no external Postgres server needed)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String?   // Nullable for Google OAuth users
  bio          String?
  location     String?
  avatarUrl    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relationships
  skillsTeach     UserSkillsTeach[]
  skillsLearn     UserSkillsLearn[]
  matchesAsUserA  Match[]           @relation("UserAMatches")
  matchesAsUserB  Match[]           @relation("UserBMatches")
  hostedEvents    Event[]           @relation("HostedEvents")
  attendances     EventAttendee[]
  reviewsGiven    Review[]          @relation("ReviewsGiven")
  reviewsReceived Review[]          @relation("ReviewsReceived")
  messages        Message[]
}

model Skill {
  id       String            @id @default(uuid())
  name     String            @unique
  category String            // e.g., "Programming", "Music", "Languages", "Design", "Cooking"

  // Relationships
  teachers UserSkillsTeach[]
  learners UserSkillsLearn[]
  matches  Match[]
}

model UserSkillsTeach {
  id          String   @id @default(uuid())
  userId      String
  skillId     String
  proficiency String   // e.g., "Beginner", "Intermediate", "Advanced", "Expert"

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill       Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
}

model UserSkillsLearn {
  id      String   @id @default(uuid())
  userId  String
  skillId String

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill   Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
}

model Match {
  id             String   @id @default(uuid())
  userAId        String
  userBId        String
  matchedSkillId String
  status         String   @default("PENDING") // PENDING, ACCEPTED, DECLINED
  createdAt      DateTime @default(now())

  userA          User     @relation("UserAMatches", fields: [userAId], references: [id], onDelete: Cascade)
  userB          User     @relation("UserBMatches", fields: [userBId], references: [id], onDelete: Cascade)
  matchedSkill   Skill    @relation(fields: [matchedSkillId], references: [id], onDelete: Cascade)
  messages       Message[]
}

model Event {
  id          String          @id @default(uuid())
  hostId      String
  title       String
  description String
  location    String
  lat         Float?
  lng         Float?
  dateTime    DateTime
  createdAt   DateTime        @default(now())

  host        User            @relation("HostedEvents", fields: [hostId], references: [id], onDelete: Cascade)
  attendees   EventAttendee[]
}

model EventAttendee {
  id      String @id @default(uuid())
  eventId String
  userId  String
  status  String @default("GOING") // GOING, MAYBE, CANCELLED

  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model Review {
  id         String   @id @default(uuid())
  fromUserId String
  toUserId   String
  rating     Int      // 1 to 5 stars
  comment    String
  createdAt  DateTime @default(now())

  fromUser   User     @relation("ReviewsGiven", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser     User     @relation("ReviewsReceived", fields: [toUserId], references: [id], onDelete: Cascade)
}

model Message {
  id        String   @id @default(uuid())
  matchId   String
  senderId  String
  content   String
  createdAt DateTime @default(now())

  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
}
